{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // The whole test directory is excluded from the build, not just *.test.ts —
  // otherwise helper modules like __tests__/fixtures.ts compile into dist/ and
  // ship inside the published tarball. Tests are still type-checked, via
  // tsconfig.test.json / `npm run typecheck`.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
